# ==============================================================================
# Second Brain Studio - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the paths to your local setup:
#   cp .env.example .env
# (You can also adjust vault paths anytime in the app via Settings: ⌘,)
# ==============================================================================

# Path to your primary Work / Knowledge Base Markdown directory (e.g. Obsidian vault)
VITE_WORK_VAULT="/Users/username/Documents/second-brain"

# Path to your personal / private Markdown directory (optional)
VITE_PRIVATE_VAULT="/Users/username/Documents/personal-brain"

# Local AI Copilot Endpoint (Ollama, LM Studio, or custom OpenAI-compatible proxy)
# Ollama:     http://127.0.0.1:11434/v1
# LM Studio:  http://127.0.0.1:1234/v1
# Default:    http://127.0.0.1:6655/openai/v1
VITE_AI_BASE_URL="http://127.0.0.1:11434/v1"
